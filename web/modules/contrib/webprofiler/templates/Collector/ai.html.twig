{% block toolbar %}

  {% if collector.callsCount > 0 %}
    {% set status = collector.errorsCount > 0 ? 'red' : (collector.guardrailsStopCount > 0 ? 'yellow') %}

    {% set icon %}
      {{ include('@webprofiler/Icon/ai.svg') }}
      <span class="sf-toolbar-value">{{ collector.callsCount }}</span>
      <span class="sf-toolbar-info-piece-additional-detail">
        <span class="sf-toolbar-label">in</span>
        <span class="sf-toolbar-value">{{ '%0.2f'|format(collector.totalDuration) }}</span>
        <span class="sf-toolbar-label">ms</span>
      </span>
    {% endset %}

    {% set text %}
      <div class="sf-toolbar-info-piece">
        <b>{{ 'Calls'|t }}</b>
        <span class="sf-toolbar-status">{{ collector.callsCount }}</span>
      </div>
      <div class="sf-toolbar-info-piece">
        <b>{{ 'Failed calls'|t }}</b>
        <span class="sf-toolbar-status {{ collector.errorsCount > 0 ? 'sf-toolbar-status-red' : '' }}">{{ collector.errorsCount }}</span>
      </div>
      <div class="sf-toolbar-info-piece">
        <b>{{ 'Total time'|t }}</b>
        <span>{{ '%0.2f'|format(collector.totalDuration) }} ms</span>
      </div>
      <div class="sf-toolbar-info-piece">
        <b>{{ 'Total tokens'|t }}</b>
        <span>{{ collector.totalTokens }}</span>
      </div>
      <div class="sf-toolbar-info-piece">
        <b>{{ 'Input tokens'|t }}</b>
        <span>{{ collector.totalInputTokens }}</span>
      </div>
      <div class="sf-toolbar-info-piece">
        <b>{{ 'Output tokens'|t }}</b>
        <span>{{ collector.totalOutputTokens }}</span>
      </div>
      <div class="sf-toolbar-info-piece">
        <b>{{ 'Guardrails'|t }}</b>
        <span>{{ collector.guardrailsCount }} / {{ collector.guardrailsConfiguredCount }} {{ 'ran'|t }} ({{ collector.guardrailsStopCount }} {{ 'stopping'|t }})</span>
      </div>
      <div class="sf-toolbar-info-piece">
        <b>{{ 'Tool calls'|t }}</b>
        <span>{{ collector.toolCallsCount }}</span>
      </div>
      {% for provider, count in collector.providers %}
        <div class="sf-toolbar-info-piece">
          <b>{{ 'Provider'|t }} {{ provider }}</b>
          <span>{{ count }}</span>
        </div>
      {% endfor %}
      {% for model, count in collector.models %}
        <div class="sf-toolbar-info-piece">
          <b>{{ 'Model'|t }} {{ model }}</b>
          <span>{{ count }}</span>
        </div>
      {% endfor %}
    {% endset %}

    {{ include('@webprofiler/Profiler/toolbar_item.html.twig', { link: profiler_url, status: status|default('') }) }}
  {% endif %}
{% endblock %}

{% block panel %}
  {{ collector.panel() }}
{% endblock %}
